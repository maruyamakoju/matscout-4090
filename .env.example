# Copy to .env and fill in. MatScout reads these via python-dotenv / os.environ.

# Materials Project API key (https://next-gen.materialsproject.org/api).
# If unset, `matscout fetch-mp` falls back to bundled fixture structures.
MP_API_KEY=

# Device for ML potentials: "cuda", "cpu", or "auto".
MATSCOUT_DEVICE=auto

# Cache directory for external API calls and downloaded models.
MATSCOUT_CACHE_DIR=data/external/cache
